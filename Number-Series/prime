import java.util.Scanner;
public class prime{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        isprime(n);
    }
    public static boolean isprime(int n){
        boolean isprime=true;
        if(n<2){
            false;
        }
        for(int i =1;i<n;i++){
            if(i%n==0){
                false;
            }
        }
        System.out.print(isprime(n));
    }
}